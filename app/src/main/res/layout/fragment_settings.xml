<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingStart="@dimen/spacing_md"
    android:paddingTop="@dimen/spacing_md"
    android:paddingEnd="@dimen/spacing_md"
    android:paddingBottom="@dimen/spacing_lg"
    tools:context=".Fragments.settings">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Display -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_sm"
            android:text="@string/settings_display"
            android:textColor="@color/settings_section_label"
            android:textSize="@dimen/text_small"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/card"
            app:cardCornerRadius="@dimen/radius_xl"
            app:cardElevation="0dp"
            app:strokeColor="@color/border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/spacing_md"
                android:paddingTop="@dimen/spacing_xs"
                android:paddingEnd="@dimen/spacing_md"
                android:paddingBottom="@dimen/spacing_xs">

                <!-- Theme: Auto (phone) / Light / Dark -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="@dimen/spacing_sm"
                    android:paddingBottom="@dimen/spacing_sm"
                    android:text="@string/settings_theme_title"
                    android:textColor="@color/foreground"
                    android:textSize="@dimen/text_body"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_sm"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_theme_auto"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/settings_choice_height"
                        android:layout_marginEnd="@dimen/spacing_xs"
                        android:layout_weight="1"
                        android:background="@drawable/bg_lang_unselected"
                        android:contentDescription="@string/cd_theme_auto"
                        android:gravity="center"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:maxLines="2"
                        android:minWidth="0dp"
                        android:paddingStart="2dp"
                        android:paddingEnd="2dp"
                        android:text="@string/settings_theme_auto"
                        android:textAllCaps="false"
                        android:textColor="@color/foreground"
                        android:textSize="@dimen/text_tiny"
                        app:backgroundTint="@null"
                        app:cornerRadius="@dimen/radius_md"
                        app:strokeWidth="0dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_theme_light"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/settings_choice_height"
                        android:layout_marginStart="@dimen/spacing_xs"
                        android:layout_marginEnd="@dimen/spacing_xs"
                        android:layout_weight="1"
                        android:background="@drawable/bg_lang_unselected"
                        android:contentDescription="@string/cd_theme_light"
                        android:gravity="center"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:maxLines="1"
                        android:minWidth="0dp"
                        android:paddingStart="2dp"
                        android:paddingEnd="2dp"
                        android:text="@string/settings_theme_light"
                        android:textAllCaps="false"
                        android:textColor="@color/foreground"
                        android:textSize="@dimen/text_tiny"
                        app:backgroundTint="@null"
                        app:cornerRadius="@dimen/radius_md"
                        app:strokeWidth="0dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_theme_dark"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/settings_choice_height"
                        android:layout_marginStart="@dimen/spacing_xs"
                        android:layout_weight="1"
                        android:background="@drawable/bg_lang_unselected"
                        android:contentDescription="@string/cd_theme_dark"
                        android:gravity="center"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:maxLines="1"
                        android:minWidth="0dp"
                        android:paddingStart="2dp"
                        android:paddingEnd="2dp"
                        android:text="@string/settings_theme_dark"
                        android:textAllCaps="false"
                        android:textColor="@color/foreground"
                        android:textSize="@dimen/text_tiny"
                        app:backgroundTint="@null"
                        app:cornerRadius="@dimen/radius_md"
                        app:strokeWidth="0dp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/border" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/touch_target"
                    android:orientation="horizontal"
                    android:paddingTop="@dimen/spacing_sm"
                    android:paddingBottom="@dimen/spacing_sm">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_font_size"
                        android:textColor="@color/foreground"
                        android:textSize="@dimen/text_body"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btn_font_small"
                            android:layout_width="@dimen/touch_target"
                            android:layout_height="@dimen/touch_target"
                            android:background="@drawable/bg_lang_unselected"
                            android:clickable="true"
                            android:contentDescription="@string/cd_font_small"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="@string/settings_font_letter"
                            android:textColor="@color/foreground"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btn_font_medium"
                            android:layout_width="@dimen/touch_target"
                            android:layout_height="@dimen/touch_target"
                            android:layout_marginStart="@dimen/spacing_xs"
                            android:background="@drawable/bg_lang_unselected"
                            android:clickable="true"
                            android:contentDescription="@string/cd_font_medium"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="@string/settings_font_letter"
                            android:textColor="@color/foreground"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btn_font_large"
                            android:layout_width="@dimen/touch_target"
                            android:layout_height="@dimen/touch_target"
                            android:layout_marginStart="@dimen/spacing_xs"
                            android:background="@drawable/bg_lang_unselected"
                            android:clickable="true"
                            android:contentDescription="@string/cd_font_large"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="@string/settings_font_letter"
                            android:textColor="@color/foreground"
                            android:textSize="24sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
